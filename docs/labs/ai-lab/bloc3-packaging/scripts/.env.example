# HikenRoot Forge — RAG Stack environment variables
# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# The .env file is gitignored and never pushed to GitHub.

# n8n basic auth (used to log into the web UI at http://<host>:5678)
N8N_USER=admin
N8N_PASSWORD=changeme_use_a_strong_password

# n8n task runner authentication token
# Generate a strong random token: openssl rand -hex 32
N8N_RUNNERS_TOKEN=changeme_use_openssl_rand_hex_32

# n8n public URL (used for webhooks and editor links)
# Replace with the IP or hostname where n8n is reachable
# Example: http://192.168.1.10:5678/
N8N_HOST_URL=http://localhost:5678/
